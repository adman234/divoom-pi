[Unit]
Description=divoom-pi - Bluetooth Classic to TCP gateway for Divoom devices
Documentation=https://github.com/adman234/divoom-pi
After=bluetooth.target network-online.target avahi-daemon.service
Wants=bluetooth.target network-online.target

[Service]
Type=simple
# @PREFIX@, @CONFIG@ and @PYTHON@ are substituted by install.sh.
Environment=PYTHONPATH=@PREFIX@
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@PREFIX@
ExecStart=@PYTHON@ -m divoom_pi run --config @CONFIG@
Restart=always
RestartSec=5

# Root, because it needs raw Bluetooth sockets, BlueZ over D-Bus, and write
# access to Avahi's service directory. ProtectSystem=full still keeps /usr
# and /boot read-only while leaving /etc/avahi/services writable.
User=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
